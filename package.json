{
  "name": "yancwords-desktop",
  "version": "1.3.3",
  "description": "鐮旇瘝鍔╂墜 路 鑰冪爺鑻辫涓€璇嶆眹宸ヤ綔鍙帮紙妗岄潰鐗堬級",
  "main": "main.js",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "prepack-app": "node scripts/prepack.js",
    "dist": "npm run prepack-app && electron-builder --win"
  },
  "build": {
    "appId": "com.iktf.yancwords",
    "productName": "鐮旇瘝鍔╂墜",
    "directories": { "output": "dist" },
    "files": ["main.js", "preload.js", "approot/**/*"],
    "win": {
      "target": ["nsis", "portable"]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "鐮旇瘝鍔╂墜",
      "artifactName": "YanCi-KaoYan-Vocab-Workbench-${version}-setup.${ext}",
      "installerLanguages": ["zh_CN", "en_US"],
      "language": "2052",
      "multiLanguageInstaller": true
    },
    "portable": {
      "artifactName": "YanCi-KaoYan-Vocab-Workbench-${version}-portable.${ext}"
    },
    "asarUnpack": ["approot/www/tessdata/**/*", "approot/www/fonts/**/*"]
  },
  "dependencies": {
    "mupdf": "^1.28.1"
  },
  "devDependencies": {
    "electron": "^44.2.0",
    "electron-builder": "^26.15.3"
  }
}
